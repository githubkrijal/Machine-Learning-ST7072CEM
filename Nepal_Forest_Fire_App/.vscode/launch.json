{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Forest Fire App",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "application/app.py",
        "--server.address",
        "127.0.0.1",
        "--theme.base",
        "light",
        "--browser.gatherUsageStats",
        "false"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    }
  ]
}